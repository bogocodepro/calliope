# Copy to .env and edit. Every value has a sensible default in config.py, so .env is
# optional. These mainly affect the live headset agent (talk.py); the Studio manages
# voices/speed/temperature in its own UI.

# ---- Brain (LLM that decides what to say) ----
# BRAIN=ollama  -> free, offline, local (default)
# BRAIN=gemini  -> free Google Gemini API (needs internet + GEMINI_API_KEY)
BRAIN=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Gemini fallback (only if BRAIN=gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Speech-to-text (live agent) ----
WHISPER_MODEL=distil-small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8

# ---- TTS (Orpheus) ----
ORPHEUS_MODEL_PATH=~/.local/share/calliope-models/orpheus-q8.gguf
ORPHEUS_VOICE=dan            # tara/leah/jess/mia/zoe (female) · leo/dan/zac (male)
ORPHEUS_TEMPERATURE=0.25     # lower = calmer/flatter delivery
ORPHEUS_SPEED=1.15           # WSOLA speed-up, pitch preserved

# ---- Sales persona (used when PERSONA=sales) ----
COMPANY_NAME=Acme Solar
AGENT_NAME=Alex
PRODUCT_PITCH=residential solar panels that cut electricity bills by up to 40%
